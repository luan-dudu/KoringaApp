# String de conexão do Neon PostgreSQL
# Obtenha em: https://console.neon.tech → seu projeto → Connection Details
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Credenciais de acesso ao painel (Login)
ADMIN_EMAIL=admin@koringa.co
ADMIN_PASSWORD=admin123
